pipeline {
    agent any

    stages {
        stage('Clone Code') {
            steps {
                echo 'Cloning the code from GitHub...'
                git url: 'https://github.com/sohitji725/jenkins-demo.git'
            }
        }

        stage('List Files') {
            steps {
                echo 'Listing all files...'
                sh 'ls -l' // Use 'dir' if on Windows
            }
        }
    }
}
